{
  "name": "drugo-html-to-video",
  "version": "0.2.0",
  "private": true,
  "description": "DRUGO HTML TO VIDEO para Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.drugo.htmltovideo.desktop",
    "productName": "DRUGO HTML TO VIDEO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "index.html",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "DRUGO-HTML-TO-VIDEO-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "DRUGO-HTML-TO-VIDEO-Portable-${version}-${arch}.${ext}"
    }
  }
}
